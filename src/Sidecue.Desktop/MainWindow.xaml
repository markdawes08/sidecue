<Window x:Class="Sidecue.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="680" Height="510"
        MinWidth="420" MinHeight="260"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        FontFamily="{DynamicResource {x:Static SystemFonts.MessageFontFamilyKey}}"
        FontSize="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32">
            <TextBlock Text="{Binding Title}"
                       FontSize="28"
                       FontWeight="SemiBold" />
            <Border Margin="0,24,0,0"
                    Padding="20"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock x:Name="StatusText"
                               Text="{Binding Status}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,12,0,0"
                               Text="{Binding Description}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="HotkeyStatusText" Margin="0,20,0,0" TextWrapping="Wrap"
                       AutomationProperties.Name="Overlay keyboard shortcuts" />
            <WrapPanel Margin="0,12,0,0">
                <Button Content="Show display" Padding="14,8"
                        Click="ShowOverlayClicked" />
                <Button Content="Enter text mode" Margin="12,0,0,0" Padding="14,8"
                        Click="EnterOverlayClicked" />
                <Button Content="Hide overlay" Margin="12,0,0,0" Padding="14,8"
                        Click="HideOverlayClicked" />
                <Button Content="Window details" Margin="12,0,0,0" Padding="14,8"
                        Click="OverlayDetailsClicked" />
            </WrapPanel>
            <TextBlock x:Name="OverlayStatusText" Margin="0,12,0,0" TextWrapping="Wrap"
                       AutomationProperties.Name="Overlay focus status" />
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                       Text="The prototype reports Windows capture-exclusion support. Screen-sharing behavior has not been verified." />
        </StackPanel>
    </ScrollViewer>
</Window>
